{
  "name": "gitconfig-man",
  "version": "1.0.0",
  "description": "A cli tool to manage multiple git config profiles and switch between different git configurations with ease & grace.",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci --maxWorkers=2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/gitconfig-man.git"
  },
  "keywords": [
    "git",
    "config",
    "gitconfig",
    "profile",
    "manage",
    "git config",
    "git profiles",
    "git user",
    "git email",
    "multiple accounts",
    "config manager",
    "gitconfig-man"
  ],
  "author": "Your Name",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yourusername/gitconfig-man/issues"
  },
  "homepage": "https://github.com/yourusername/gitconfig-man#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^10.0.0",
    "inquirer": "^8.2.5",
    "inquirer-autocomplete-prompt": "^2.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "@types/jest": "^29.5.11"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/*.spec.js",
      "!src/__tests__/helpers.js",
      "!src/__tests__/testUtils.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "helpers.js",
      "testUtils.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/coverage/",
      "/__tests__/helpers.js",
      "/__tests__/testUtils.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "coverage",
          "outputName": "junit.xml",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}",
          "ancestorSeparator": " › ",
          "usePathForSuiteName": "true"
        }
      ]
    ]
  }
}

